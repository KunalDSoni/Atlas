# ===== ATLAS CONFIGURATION =====
# Copy this file to .env and edit values

# ---------- Environment ----------
NODE_ENV=development
PORT=3001

# ---------- Database ----------
# "sqlite" for local dev, "mysql" for production
DB_DRIVER=sqlite

# SQLite (local dev only)
SQLITE_PATH=./data.db

# MySQL (production) — either set discrete parts below...
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=atlas
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=atlas
# ...or a single connection URL (takes precedence over the parts above)
# DATABASE_URL=mysql://atlas:change-me@127.0.0.1:3306/atlas

# ---------- Auth ----------
# REQUIRED in production. Signs attachment URLs — a known value lets anyone forge
# file access. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production
# Session expiry in days
SESSION_EXPIRY_DAYS=7

# ---------- CORS ----------
# Comma-separated allow-list of browser origins, e.g. https://atlas.example.com
# Leave empty for same-origin only (correct when this server also serves the SPA).
# Never set this to "*".
CORS_ORIGINS=

# ---------- Seed Data ----------
# Set to "true" to populate demo data on first run
# Set to "false" for a clean empty database (real data)
SEED_DEMO_DATA=true

# ---------- Admin Account ----------
# Created on first run when SEED_DEMO_DATA=false
ADMIN_NAME=Kunal Soni
ADMIN_EMAIL=admin@atlas.local
ADMIN_PASSWORD=changeme123

# ---------- AI assistant (Rovo-style wiki AI) ----------
# Set an Anthropic API key to enable AI features (page summaries, in-editor
# writing assistant, ask-your-wiki). Leave unset to keep AI off — the app stays
# fully usable and the AI buttons simply don't appear. Get a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Per-feature models (optional). Defaults balance cost and quality:
#   summaries → Haiku (fast/cheap), writing → Sonnet, ask → Opus (best reasoning).
# ANTHROPIC_MODEL, if set, overrides all three at once.
# ANTHROPIC_MODEL=
# AI_SUMMARY_MODEL=claude-haiku-4-5
# AI_WRITE_MODEL=claude-sonnet-5
# AI_ASK_MODEL=claude-opus-4-8
