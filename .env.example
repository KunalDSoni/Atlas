# ===== Atlas Environment Configuration =====
# Copy this file to .env and update the values

# Application
NODE_ENV=production
PORT=3001
# REQUIRED. Signs attachment URLs — generate with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-64-char-string

# Comma-separated browser origin allow-list. Empty = same-origin only. Never "*".
CORS_ORIGINS=

# Nginx ports (host mapping)
NGINX_PORT=80
NGINX_SSL_PORT=443

# Database
# DB_DRIVER=mysql for production, sqlite for local dev
DB_DRIVER=mysql
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=atlas
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=atlas
# Root password for the bundled MySQL container (docker-compose)
MYSQL_ROOT_PASSWORD=change-me-root

# TLS to the database. Leave false locally; set true when the database is on
# another host. Set MYSQL_SSL_CA only if the provider uses its own CA.
MYSQL_SSL=false
# MYSQL_SSL_CA=/path/to/provider-ca.pem
# Connections per container. Keep small so many tenants can share one server.
MYSQL_POOL_SIZE=5

# SQLite fallback (only used when DB_DRIVER=sqlite)
DATA_DIR=/app/data

# ===== First run =====
# false in production. true seeds five demo users who all share the password
# `password123` — never expose that on a real deployment (see SECURITY.md).
SEED_DEMO_DATA=false
# With seeding off, this is the ONLY account that exists on first boot. Sign in
# with it, then create the first project from the sidebar switcher or the
# dashboard zero state. Change the password immediately after logging in.
ADMIN_NAME=Atlas Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-first-boot

# ===== File storage =====
# Uploads go to backend/uploads on local disk. Where the host erases its disk
# on redeploy, mount a persistent volume there.

# Base URL for links in notification emails. Must be the app's real URL.
# APP_URL=https://atlas.example.com

# ---- Public demo (optional) ----
# Setting DEMO_EMAIL enables POST /api/auth/demo, which hands anonymous
# visitors a session on a throwaway account so the landing page's
# "Try the live demo" button works. Leave it unset to disable the route
# entirely — it responds 404 when this is empty.
#
# Independent of SEED_DEMO_DATA: the demo workspace is seeded separately, so
# enabling a public demo never re-introduces the password123 accounts.
DEMO_EMAIL=
DEMO_NAME=Demo user
# Hours before a visit re-seeds the demo workspace. Default 6.
DEMO_RESET_HOURS=6
