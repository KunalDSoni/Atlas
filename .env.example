# ===== Atlas Environment Configuration =====
# Copy this file to .env and update the values

# Application
NODE_ENV=production
PORT=3001
# REQUIRED. Signs attachment URLs — generate with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-64-char-string

# Comma-separated browser origin allow-list. Empty = same-origin only. Never "*".
CORS_ORIGINS=

# Nginx ports (host mapping)
NGINX_PORT=80
NGINX_SSL_PORT=443

# Database
# DB_DRIVER=mysql for production, sqlite for local dev
DB_DRIVER=mysql
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=atlas
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=atlas
# Root password for the bundled MySQL container (docker-compose)
MYSQL_ROOT_PASSWORD=change-me-root

# TLS to the database. Leave false locally; set true on AWS/RDS, where the
# connection crosses a network. The CA bundle is baked into the image.
MYSQL_SSL=false
MYSQL_SSL_CA=/app/certs/rds-global-bundle.pem
# Connections per container. Keep small so many tenants can share one server.
MYSQL_POOL_SIZE=5

# SQLite fallback (only used when DB_DRIVER=sqlite)
DATA_DIR=/app/data

# ===== First run =====
# false in production. true seeds five demo users who all share the password
# `password123` — never expose that on a real deployment (see SECURITY.md).
SEED_DEMO_DATA=false
# With seeding off, this is the ONLY account that exists on first boot. Sign in
# with it, then create the first project from the sidebar switcher or the
# dashboard zero state. Change the password immediately after logging in.
ADMIN_NAME=Atlas Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-first-boot

# ===== File storage =====
# Unset  → uploads go to backend/uploads on local disk (dev and tests).
# Set    → uploads go to S3. REQUIRED in production: a container's disk is
#          erased on every restart, so local files would not survive a deploy.
# S3_PREFIX isolates each tenant; its IAM role permits that prefix only.
# S3_BUCKET=atlas-uploads-<account-id>
# S3_PREFIX=<tenant-slug>
# AWS_REGION=ap-south-1

# Base URL for links in notification emails. Must be the tenant's real URL.
# APP_URL=https://<tenant>.open-atlas.xyz
