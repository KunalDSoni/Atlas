// Cloudflare Worker deployment (Workers & Pages -> Create -> Worker, or
// `npx wrangler deploy` after `npm run build`). Set BACKEND_URL on the Worker
// under Settings -> Variables and Secrets. Cloudflare Pages ignores this file.
{
  "name": "atlas",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/demo", "/demo/*"]
  },
  // Keep BACKEND_URL set in the dashboard across deploys.
  "keep_vars": true
}
